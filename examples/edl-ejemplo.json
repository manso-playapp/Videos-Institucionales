      "out": 3.0,
      "speed": 0.75,
      "move": {
        "type": "push_in",
        "amount": 0.05
      },
      "audio": true,
      "audio_gain_db": -18
    },
    {
      "src": "media/planta_1080_25p.mp4",
      "in": 1.0,
      "out": 3.4,
      "move": {
        "type": "pan_right",
        "amount": 0.06
      },
      "transition_in": {
        "type": "gl:DirectionalWarp",
        "dur": 0.8,
        "ease": "cubic-in-out"
      }
    },
    {
      "src": "media/detalle_1080_25p.mp4",
      "in": 0.0,
      "out": 2.0,
      "transition_in": {
        "type": "slideleft",
        "dur": 0.6,
        "ease": "quint-in-out"
      }
    },
    {
      "split": [
        {
          "src": "media/aereo_4k_50p.mp4",
          "in": 4.0
        },
        {
          "src": "media/planta_1080_25p.mp4",
          "in": 2.0,
          "move": {
            "type": "push_in",
            "amount": 0.08
          }
        },
        {
          "src": "media/detalle_1080_25p.mp4",
          "in": 1.0
        }
      ],
      "dur": 2.4,
      "gap": 14,
      "transition_in": {
        "type": "dissolve",
        "dur": 0.4
      }
    },
    {
      "src": "media/cierre.mov",
      "transition_in": {
        "type": "gl:CrossZoom",
        "dur": 0.8,
        "ease": "cubic-in-out"
      },
      "global_grade": false
    }
  ],
  "texts": [],
  "subtitles": {
