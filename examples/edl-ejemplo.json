{
  "output": "render/ejemplo_master.mp4",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "fps": 25
  },
  "grade": {
    "lut": "assets/luts/estudio_industrial.cube",
    "contrast": 1.02,
    "vignette": true,
    "grain": 3
  },
  "fade": {
    "in": 0.8,
    "out": 0.0
  },
  "clips": [
    {
      "src": "media/aereo_4k_50p.mp4",
